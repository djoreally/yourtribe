# Neon PostgreSQL (use Neon pooled connection string with sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate a value with `npx auth@latest secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Resend transactional email for Better Auth verification and password recovery.
# Use a server-side key only; never expose this through a NEXT_PUBLIC_ variable.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Northstar <hello@momsoilchange.com>"

# Content delivery and storage (implement a short-lived signer behind the endpoint)
STORAGE_UPLOAD_ENDPOINT=""

# Ayrshare multi-tenant distribution
AYRSHARE_API_KEY=""

# Optional: use `false` to disable any legacy GTM script if legacy routes are retained.
NEXT_PUBLIC_ENABLE_GTM="false"
